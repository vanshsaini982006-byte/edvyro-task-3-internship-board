# Copy this file to .env and change what you need. Placeholders only - never put real secrets here.
# .env is listed in .gitignore and must never be committed.
# On Render, set these in the dashboard (Environment tab) instead of using a .env file.

PORT=3000
NODE_ENV=development
DATABASE_PATH=./database/internship-board.db

# Rate limiting (per client IP, per window). Defaults are shown.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_APPLICATION_MAX=10

# Logging. LOG_LEVEL: debug | info | warn | error | silent.  LOG_FORMAT: text | json.
# Defaults: info, and json when NODE_ENV=production, text otherwise.
LOG_LEVEL=info
LOG_FORMAT=text

# How long browsers may reuse CSS/JS without asking the server again, in seconds.
# Default: 300 in production, 0 (always check) otherwise.
STATIC_MAX_AGE_SECONDS=

# Only needed when the frontend is hosted on a DIFFERENT origin than this server.
# Comma-separated list of exact origins, e.g. https://my-frontend.example.com
CORS_ORIGIN=
# The address the browser should call for the API. Leave empty when this server also serves the page.
PUBLIC_API_BASE_URL=

# Number of reverse proxies in front of the app (Render, Railway, nginx ...). Use 1 on Render.
# Leave 0 when running locally, otherwise clients could fake their IP address.
TRUST_PROXY=0
